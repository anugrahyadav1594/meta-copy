# =========================================================================
# MetaScale environment configuration
# Copy to `.env` and adjust. Never commit `.env` — no credentials live in
# source; every value below is a local development default.
# =========================================================================

APP_ENV=development
DEBUG=true
APP_NAME=MetaScale
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------ modes
# Every mode below is implemented. The mode selects which layers are ACTIVE;
# no code path is compiled out, so switching modes needs no rebuild.
#   NORMALIZED          canonical PostgreSQL only
#   DENORMALIZED        + derived denormalized_post_feed read model
#   SHARDED             + shard router over independent PostgreSQL shards
#   SHARDED_REPLICATED  + read/write split over replicas inside each shard
#   SHARDED_CACHED      + Redis cache-aside above the repository
#   FULL_DISTRIBUTED    all of the above at once (the demo mode)
MODE=NORMALIZED

# ------------------------------------------------------------- PostgreSQL
# Canonical, normalized source of truth (single instance in NORMALIZED mode)
DATABASE_URL=postgresql+psycopg://metascale:metascale@postgres:5432/metascale
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=5000
DB_CONNECT_TIMEOUT=5

# --------------------------------------------------------------- sharding
SHARDING_ENABLED=false
SHARDING_STRATEGY=consistent_hash     # consistent_hash | hash
SHARD_COUNT=4
VIRTUAL_NODES_PER_SHARD=150

SHARD_0_URL=postgresql+psycopg://metascale:metascale@postgres-shard-0:5432/metascale
SHARD_1_URL=postgresql+psycopg://metascale:metascale@postgres-shard-1:5432/metascale
SHARD_2_URL=postgresql+psycopg://metascale:metascale@postgres-shard-2:5432/metascale
SHARD_3_URL=postgresql+psycopg://metascale:metascale@postgres-shard-3:5432/metascale
# Spare shard, used by the live 4 -> 5 online rebalancing demo
SHARD_4_URL=postgresql+psycopg://metascale:metascale@postgres-shard-4:5432/metascale

# Hot-shard detection thresholds (fraction of total load)
HOT_SHARD_LOAD_RATIO_THRESHOLD=0.40
HOT_SHARD_MIN_REQUESTS=100
HOT_SHARD_RELATIVE_RATIO=1.8

# ------------------------------------------------------------ replication
# Real streaming standbys (compose profile "replication"). When a replica URL
# is set and healthy, reads are served from the replica and writes always go
# to the primary; lag and health decide whether the replica is used at all.
REPLICATION_ENABLED=false
SHARD_0_REPLICA_URL=
SHARD_1_REPLICA_URL=
SHARD_2_REPLICA_URL=
SHARD_3_REPLICA_URL=
REPLICA_MAX_LAG_SECONDS=5

# ------------------------------------------------------------------- cache
# Member 6 distributed Redis cache-aside (TTL-based, above the repository;
# PostgreSQL stays the source of truth). When CACHE_ENABLED=true and Redis is
# unreachable, the API fails open and serves straight from PostgreSQL.
CACHE_ENABLED=false
REDIS_URL=redis://redis:6379/0
CACHE_DEFAULT_TTL=60
CACHE_HOT_KEY_THRESHOLD=5
CACHE_CONNECT_TIMEOUT=2.0
CACHE_FAIL_OPEN=true
# Dev/test only: REDIS_URL=memory:// uses an in-process fakeredis, no server.

# ------------------------------------------------- denormalization + feed
# Member 3: derived read model, kept in step by domain events, rebuildable.
DENORMALIZED_ENABLED=false
# Member 7: pull (follow graph -> candidates -> rank) or push (fan-out table)
FEED_STRATEGY=pull

# ------------------------------------------------------------- messaging
# Member 15: memory (default, always available) | rabbitmq | off
EVENT_BUS=memory
RABBITMQ_URL=amqp://metascale:metascale@rabbitmq:5672/

# ---------------------------------------------------------------- search
# Member 10: memory (in-process inverted index) | opensearch
SEARCH_PROVIDER=memory
OPENSEARCH_URL=http://opensearch:9200

# ----------------------------------------------------------------- media
# Member 8: local (filesystem adapter) | minio (real object storage)
MEDIA_BACKEND=local
MEDIA_ROOT=var/media
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=metascale
MINIO_SECRET_KEY=metascaleminio
MINIO_BUCKET=metascale-media

# --------------------------------------------------------- observability
# Member 11: GET /metrics is the Prometheus scrape target (no push needed).
PROMETHEUS_URL=http://prometheus:9090

# --------------------------------------------------------------- seeding
SEED_SIZE=small                       # small | medium | large
SEED_RANDOM_SEED=20260910             # deterministic: same data every run
