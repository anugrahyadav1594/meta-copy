# =========================================================================
# MetaScale environment configuration
# Copy to `.env` and adjust. Never commit `.env`.
# =========================================================================

APP_ENV=development
DEBUG=true
APP_NAME=MetaScale
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------ modes
# Deployment mode. Only NORMALIZED and SHARDED are *implemented* now.
# DENORMALIZED / SHARDED_REPLICATED / SHARDED_CACHED / FULL_DISTRIBUTED
# are reserved enums owned by other team members.
MODE=NORMALIZED

# ------------------------------------------------------------- PostgreSQL
# Canonical, normalized source of truth (single instance in NORMALIZED mode)
DATABASE_URL=postgresql+psycopg://metascale:metascale@postgres:5432/metascale
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=5000
DB_CONNECT_TIMEOUT=5

# --------------------------------------------------------------- sharding
SHARDING_ENABLED=false
SHARDING_STRATEGY=consistent_hash
SHARD_COUNT=4
VIRTUAL_NODES_PER_SHARD=150

SHARD_0_URL=postgresql+psycopg://metascale:metascale@postgres-shard-0:5432/metascale
SHARD_1_URL=postgresql+psycopg://metascale:metascale@postgres-shard-1:5432/metascale
SHARD_2_URL=postgresql+psycopg://metascale:metascale@postgres-shard-2:5432/metascale
SHARD_3_URL=postgresql+psycopg://metascale:metascale@postgres-shard-3:5432/metascale

# Hot-shard detection thresholds (fraction of total load)
HOT_SHARD_LOAD_RATIO_THRESHOLD=0.40
HOT_SHARD_MIN_REQUESTS=100
HOT_SHARD_RELATIVE_RATIO=1.8

# ------------------------------------------------------- future services
# Placeholders owned by other members. Not used by the current code paths.
REDIS_URL=redis://redis:6379/0
CACHE_DEFAULT_TTL=60
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//
OPENSEARCH_URL=http://opensearch:9200
MINIO_ENDPOINT=minio:9000
PROMETHEUS_URL=http://prometheus:9090

# --------------------------------------------------------------- seeding
SEED_SIZE=small
SEED_RANDOM_SEED=20260910
